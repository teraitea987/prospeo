# Exemple uniquement : pnpm db:setup génère .env avec un mot de passe aléatoire.
POSTGRES_PASSWORD=replace-with-a-local-random-secret
DATABASE_URL=postgresql://prospeo:replace-with-a-local-random-secret@127.0.0.1:5432/prospeo
# Contexte local optionnel, jamais accepté en production :
# LOCAL_DB_ACCESS=enabled
# LOCAL_WORKSPACE_ID=uuid-du-workspace-local
